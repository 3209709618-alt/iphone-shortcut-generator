#define name CsvAppendProbe
#define inputs text
#include 'actions/documents'

// Only synthetic data, in a separate validation folder.
createFolder("GeneratorValidation")
@file = getFile("GeneratorValidation/probe.csv", nil, false)
if !@file {
    @header = "日期,金额,分类,备注"
    saveFile("GeneratorValidation/probe.csv", @header, false)
}
@row = "2000-01-01,28.00,餐饮,测试数据"
appendToFile("GeneratorValidation/probe.csv", @row)
show("请在文件 App 检查 Shortcuts/GeneratorValidation/probe.csv；再次运行应追加一行并保留原记录。")
