#define name BrowserActionsProbe
#define inputs text
#include 'actions/sharing'
#include 'actions/text'
#include 'actions/web'

const words = text("测试数据 <&> 中文")
const answer = prompt("测试输入", "Text")
const clip = getClipboard()
setClipboard(clip, true)
speak("测试朗读", true)
showNotification("测试通知", nil, true)
openURL("https://www.apple.com.cn")
show("测试组合：{words} {answer} {clip} {ShortcutInput}")
